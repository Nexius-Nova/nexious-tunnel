# Nexious Tunnel 控制中心生产环境模板。
# 复制为 deploy/.env 并填好所有必填项（标记「必填」）后再启动。
# 本文件只放模板，不含任何真实密钥；真实 .env 永远不要提交到仓库。

# ── 数据库（compose 的 mysql 服务同样读取这四项）─────────────────
NEXIOUS_MYSQL_DATABASE=nexious_tunnel
NEXIOUS_MYSQL_USER=nexious_tunnel_app
# 必填：应用连接 MySQL 的密码。生成：openssl rand -base64 24
NEXIOUS_MYSQL_PASSWORD=
# 必填：MySQL root 密码（仅容器初始化与运维用，应用不使用）。生成：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
# 数据库跨服务器部署时配置可信 CA 文件，开启证书校验。
# NEXIOUS_MYSQL_SSL_CA=/etc/nexious/mysql-ca.pem

# ── 服务基础 ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=8787
# 容器内监听全部网卡（compose 已强制覆盖）；公网入口只有 Caddy。
BIND_HOST=0.0.0.0

# 首个管理员账号：仅空库首次启动时生效，引导完成后建议把密码行清空。
NEXIOUS_BOOTSTRAP_ADMIN=admin
# 必填（生产环境空库首次启动强制要求，至少 8 位，登录后会强制改密）。
NEXIOUS_BOOTSTRAP_ADMIN_PASSWORD=

# 必填：机器间同步令牌，等价于管理员，节点部署与桌面端本地自举使用。
# 生成：openssl rand -hex 32
NEXIOUS_ADMIN_TOKEN=

# ── 对外域名与来源白名单 ─────────────────────────────────────────
# 必填：控制中心公网域名（Caddy 用它签发证书）。
NEXIOUS_PUBLIC_HOST=nexious.example.com
# 桌面客户端（Tauri）固定携带 tauri://localhost / http://tauri.localhost，
# 追加你的控制中心域名；不要写通配符 *。
NEXIOUS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://nexious.example.com
# 已置于可信反代（Caddy）之后，开启后才能记录真实客户端 IP。
NEXIOUS_TRUST_PROXY_HEADERS=1

# 演示数据：生产必须为 0。
NEXIOUS_SEED_DEMO=0

# ── 容量与保留策略（可选，默认值见服务端）────────────────────────
# NEXIOUS_MAX_BODY_MB=25
# NEXIOUS_MAX_WS_MB=64
# NEXIOUS_MAX_INFLIGHT=256
# NEXIOUS_MAX_INFLIGHT_PER_TUNNEL=32
# NEXIOUS_LOG_RETENTION_DAYS=30
# NEXIOUS_TRAFFIC_RETENTION_DAYS=90

# ── 邮箱验证码（注册/绑定邮箱用，不配置则无法自助注册）────────────
RESEND_API_KEY=
RESEND_FROM=Nexious Tunnel <no-reply@example.com>
RESEND_REPLY_TO=
RESEND_API_URL=https://api.resend.com

# ── 支付宝当面付（付费套餐，不配置则仅免费套餐可用）──────────────
# 应用私钥（PKCS8，单行 base64 或完整 PEM 均可）。
ALIPAY_PRIVATE_KEY=
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
# 推荐配置支付宝公钥，对响应与异步通知验签。
ALIPAY_PUBLIC_KEY=
# 异步通知地址（公网可达时配置，否则依赖前端轮询查单）。
# ALIPAY_NOTIFY_URL=https://nexious.example.com/api/billing/alipay/notify
