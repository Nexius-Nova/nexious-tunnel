NODE_ENV=production
BIND_HOST=127.0.0.1
PORT=8787
NEXIOUS_DB_DRIVER=mysql
NEXIOUS_MYSQL_HOST=127.0.0.1
NEXIOUS_MYSQL_PORT=3306
NEXIOUS_MYSQL_DATABASE=nexious_tunnel
NEXIOUS_MYSQL_USER=nexious_tunnel_app
NEXIOUS_MYSQL_PASSWORD=
NEXIOUS_MYSQL_POOL_SIZE=10
# 数据库跨服务器连接时配置可信 CA 文件，开启证书校验。
# NEXIOUS_MYSQL_SSL_CA=/etc/nexious/mysql-ca.pem
NEXIOUS_BOOTSTRAP_ADMIN=admin
# 仅空数据库首次启动使用，至少 8 位；引导完成后从配置中删除。
NEXIOUS_BOOTSTRAP_ADMIN_PASSWORD=
# 仅机器间同步使用，生成独立随机令牌，不要提供给普通用户。
NEXIOUS_ADMIN_TOKEN=
# 显式设为 1 才会写入演示节点/隧道/流量；默认不写入。
NEXIOUS_SEED_DEMO=0
NEXIOUS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420
# 仅在源站无法被公网直接访问且前置代理可信时开启。
NEXIOUS_TRUST_PROXY_HEADERS=0

# 邮箱验证码使用 Resend，密钥仅存放在服务端私有配置中。
RESEND_API_KEY=
RESEND_FROM=Nexious Tunnel <no-reply@example.com>
RESEND_REPLY_TO=
RESEND_API_URL=https://api.resend.com

# 支付宝当面付（扫码支付）：应用私钥与 APPID 都配置后付费套餐才能下单。
# 应用私钥（PKCS8），支持单行 base64 或带 -----BEGIN PRIVATE KEY----- 的完整 PEM；
# 密钥可在支付宝开放平台「密钥工具」生成，公钥需上传到开放平台应用配置。
ALIPAY_PRIVATE_KEY=
# 支付宝开放平台应用 APPID
ALIPAY_APP_ID=
# 商户 PID（收款账号）
ALIPAY_SELLER_ID=
# 可选：支付宝公钥（配置后对响应与通知验签，推荐配置）
ALIPAY_PUBLIC_KEY=
# 可选：沙箱网关（默认正式环境 https://openapi.alipay.com/gateway.do）
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 可选：支付宝服务器异步通知地址（公网可达时配置，否则依赖前端轮询查单）
# ALIPAY_NOTIFY_URL=
