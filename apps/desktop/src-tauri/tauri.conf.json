{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexious Tunnel",
  "version": "1.0.0",
  "identifier": "com.nexious.tunnel",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm prepare-runtime",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nexious Tunnel",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#101315",
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["resources/node.exe", "resources/server"]
  }
}
